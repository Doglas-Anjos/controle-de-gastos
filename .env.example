# Copie para .env e preencha. O .env NUNCA e commitado (ver .gitignore).

# Meu Pluggy: crie conta em https://meu.pluggy.ai, conecte seus bancos e pegue as
# credenciais em https://dashboard.pluggy.ai (aba Application). Os item ids aparecem
# no dashboard apos vincular as conexoes do Meu Pluggy a aplicacao.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=   # separados por virgula

# OpenAI (dicas de economia). Deixe OPENAI_API_KEY vazio para desativar insights.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Banco local (SQLite). Fica dentro de data/, que e gitignored.
GASTOS_DB_PATH=data/gastos.db

# Opcional: pseudonimiza nomes de comerciantes antes de enviar ao LLM (true/false)
INSIGHTS_PSEUDONIMIZAR=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
